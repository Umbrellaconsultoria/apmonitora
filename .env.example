# Configurações do Banco de Dados PostgreSQL
DB_USUARIO=apmonitora
DB_SENHA=apmonitora_pass
DB_DATABASE=apmonitora_db
DB_PORTA=5432

# URL de Conexão com o Banco (Usado em execução local fora do Docker)
DATABASE_URL=postgresql://apmonitora:apmonitora_pass@localhost:5432/apmonitora_db?schema=public

# Configurações da API Backend Node.js
PORT=3001
CORS_ORIGINS=*
UPLOAD_DIR=./uploads
FACE_SERVICE_URL=http://localhost:8000
